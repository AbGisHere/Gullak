# AGENTS.md › Git rules › 3. CI runs lint, typecheck, tests, build and e2e on every push and PR.
# Locally we only guard releases on main (versions in sync, dated changelog, tag present).
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  node scripts/check-release.mjs --tag || exit 1
fi
