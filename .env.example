# Copy to apps/web/.env.local and fill in. Never commit real values.
# Every variable is optional: the app runs on local state + committed snapshots without any of them.

# ── Supabase (free tier) ─ dashboard → Project Settings → API ──────────────
# Public project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser; access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key for server-only jobs (seeding, migrations). NEVER expose to the browser.
SUPABASE_SECRET_KEY=

# ── AI (free tiers) ────────────────────────────────────────────────────────
# Providers tried in this order; only those with a key are used. No key → tutor answers from topic content.
AI_PROVIDER_ORDER=google,groq
# Free key from https://aistudio.google.com/apikey (no card needed). Free tier may use prompts for training: never send real personal data.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default: gemini-flash-latest).
AI_GOOGLE_MODEL=
# Free key from https://console.groq.com/keys (backup provider).
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile).
AI_GROQ_MODEL=

# ── Translation ────────────────────────────────────────────────────────────
# Bhashini (Govt. of India) credentials for en/hi/te translation. LLM fallback when unset.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# ── Testing (optional) ─────────────────────────────────────────────────────
# Real-device mobile checks. Skipped gracefully when unset.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
