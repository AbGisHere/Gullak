supabase/.branches
supabase/.temp

# notebooks: checkpoints and local datasets
.ipynb_checkpoints/
__pycache__/
*.pyc
notebooks/**/*.csv
!data/**

# personal agent settings (shared ones are committed)
.claude/settings.local.json
.impeccable/*.local.json
.gemini/*.local.json

# os / editor
.DS_Store
*.pem
.idea/
*.swp
npm-debug.log*
