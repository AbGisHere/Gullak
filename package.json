{
  "name": "gullak",
  "version": "0.2.4",
  "private": true,
  "description": "Gullak: adaptive financial literacy with play money on real market data.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @gullak/web test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release": "node scripts/release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:attribution": "node scripts/check-attribution.mjs",
    "snapshots:mf": "node scripts/snapshots/mf-nav.mjs",
    "snapshots:fd": "node scripts/snapshots/fd-rates.mjs",
    "test:db": "node scripts/test-database.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
