# Copy to apps/web/.env.local and fill in. Never commit real values.
# The UI skeleton starts without keys. Persistent backend routes require all three Supabase variables.

# ── Supabase (free tier) ─ dashboard → Project Settings → API ──────────────
# Public project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser; access is enforced by row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key for server-side backend transactions. NEVER expose to the browser.
SUPABASE_SECRET_KEY=

# ── AI (free tiers) ────────────────────────────────────────────────────────
# Providers tried in this order; only those with a key are used. No key → tutor answers from topic content.
AI_PROVIDER_ORDER=google,groq
# Free key from https://aistudio.google.com/apikey (no card needed). Free tier may use prompts for training: never send real personal data.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (default: gemini-flash-latest).
AI_GOOGLE_MODEL=
# Free key from https://console.groq.com/keys (backup provider).
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile).
AI_GROQ_MODEL=

# ── Translation ────────────────────────────────────────────────────────────
# Server/authoring-only Sarvam key. Never use a NEXT_PUBLIC_ prefix or commit a real value.
# Translation command is dry-run by default; --execute spends credits under its character ledger.
# Run with node --env-file=apps/web/.env.local scripts/translate-text.mjs --smoke
# For legacy repo-root .env.local, explicitly use --env-file=.env.local instead.
# Draft translations require R5 review; no live UI/provider activation is implied by this key.
SARVAM_API_KEY=

# ── Testing (optional) ─────────────────────────────────────────────────────
# Real-device mobile checks. Skipped gracefully when unset.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
