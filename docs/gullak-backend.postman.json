{
  "info": {
    "name": "Gullak R3 backend",
    "description": "Local manual tests. Set public project URL/key and obtain a learner access token. Never add the Supabase server secret. Run core loop requests in order; retain keys and token for idempotency and persistence tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "supabaseUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "publishableKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "savingsQuizKey",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "fdQuizKey",
      "value": "22222222-2222-4222-8222-222222222222",
      "type": "string"
    },
    {
      "key": "investmentKey",
      "value": "33333333-3333-4333-8333-333333333333",
      "type": "string"
    },
    {
      "key": "cohortId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create anonymous learner session (Supabase)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "apikey",
            "value": "{{publishableKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{supabaseUrl}}/auth/v1/signup"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session created', () => pm.response.to.have.status(200));",
              "const session = pm.response.json();",
              "if (session.access_token) pm.collectionVariables.set('accessToken', session.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Onboard",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/onboarding",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ageBand\": \"college\",\n  \"experience\": \"none\",\n  \"locale\": \"en\",\n  \"preferredFormats\": [\n    \"transcript\",\n    \"quiz\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Read savings lesson",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lessons/savings-account"
      }
    },
    {
      "name": "4. Record savings lesson",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/savings-account/progress",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"read\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Grade savings quiz",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{savingsQuizKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/savings-account/quiz",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"check\",\n  \"answers\": [\n    {\n      \"questionId\": \"virtual-money\",\n      \"optionId\": \"0\"\n    },\n    {\n      \"questionId\": \"saving-purpose\",\n      \"optionId\": \"0\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Read FD lesson",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lessons/fixed-deposit"
      }
    },
    {
      "name": "7. Record FD lesson",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/fixed-deposit/progress",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"read\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Grade FD quiz",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{fdQuizKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/fixed-deposit/quiz",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"check\",\n  \"answers\": [\n    {\n      \"questionId\": \"fd-rate\",\n      \"optionId\": \"0\"\n    },\n    {\n      \"questionId\": \"fd-assumptions\",\n      \"optionId\": \"0\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. Check unlocks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/progress"
      }
    },
    {
      "name": "10. Open virtual FD (repeat unchanged to test idempotency)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{investmentKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/portfolio/fd",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"principalPaise\": 100000,\n  \"tenureMonths\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. Read persisted portfolio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/portfolio"
      }
    },
    {
      "name": "12. Goal assumptions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/goals/plan",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetPaise\": 9000000,\n  \"currentSavingsPaise\": 0,\n  \"months\": 24,\n  \"assumedAnnualRatePercent\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13. Dated FD snapshot",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/market/FD-1Y"
      }
    },
    {
      "name": "14. NAV quote with fallback",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/market/120716"
      }
    },
    {
      "name": "15. Real NAV history replay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/time-machine",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symbol\": \"120716\",\n  \"from\": \"2020-02-01T00:00:00+05:30\",\n  \"to\": \"2020-04-30T23:59:59+05:30\",\n  \"initialPaise\": 100000,\n  \"panicSellAt\": \"2020-03-23T00:00:00+05:30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "16. Assigned facilitator aggregate (requires admin membership)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/facilitator/cohorts/{{cohortId}}/progress"
      }
    }
  ]
}
