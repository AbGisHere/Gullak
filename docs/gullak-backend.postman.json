{
  "info": {
    "name": "Gullak R3 backend",
    "description": "Local manual tests. Set public project URL/key and obtain a learner access token. Never add the Supabase server secret. Run core loop requests in order; retain keys and token for idempotency and persistence tests. Current graph requires money-basics and saving-habit before bank-accounts-upi and FD. New run routes persist navigation only, not scores/completion. Keep learner A/B tokens separate; never seed shared Auth rows. Activity answers persist server-graded evidence and run completion only; never send scores, correctness, money or mastery.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "supabaseUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "publishableKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "savingsQuizKey",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "fdQuizKey",
      "value": "22222222-2222-4222-8222-222222222222",
      "type": "string"
    },
    {
      "key": "investmentKey",
      "value": "33333333-3333-4333-8333-333333333333",
      "type": "string"
    },
    {
      "key": "cohortId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "startRunKey",
      "value": "33333333-3333-4333-8333-333333333333",
      "type": "string"
    },
    {
      "key": "bookmarkKey",
      "value": "44444444-4444-4444-8444-444444444444",
      "type": "string"
    },
    {
      "key": "accessTokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "activityAnswerKey",
      "value": "90000000-0000-4000-8000-000000000001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create anonymous learner session (Supabase)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "apikey",
            "value": "{{publishableKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{supabaseUrl}}/auth/v1/signup"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Session created', () => pm.response.to.have.status(200));",
              "const session = pm.response.json();",
              "if (session.access_token) pm.collectionVariables.set('accessToken', session.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Onboard",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/onboarding",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"experience\": \"none\",\n  \"locale\": \"en\",\n  \"preferredFormats\": [\n    \"transcript\",\n    \"quiz\"\n  ],\n  \"gradeGroup\": \"grade-8-10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Prerequisite: money-basics",
      "item": [
        {
          "name": "Read money-basics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lessons/money-basics"
          }
        },
        {
          "name": "Record transcript",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/lessons/money-basics/progress",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"read\"\n}"
            }
          }
        },
        {
          "name": "Submit server-graded quiz",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "11111111-1111-4111-8111-111111111111"
              }
            ],
            "url": "{{baseUrl}}/api/lessons/money-basics/quiz",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"check\",\n  \"answers\": [\n    {\n      \"questionId\": \"money-in\",\n      \"optionId\": \"0\"\n    },\n    {\n      \"questionId\": \"money-out\",\n      \"optionId\": \"0\"\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Prerequisite: saving-habit",
      "item": [
        {
          "name": "Read saving-habit",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/lessons/saving-habit"
          }
        },
        {
          "name": "Record transcript",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/lessons/saving-habit/progress",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"read\"\n}"
            }
          }
        },
        {
          "name": "Submit server-graded quiz",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "22222222-2222-4222-8222-222222222222"
              }
            ],
            "url": "{{baseUrl}}/api/lessons/saving-habit/quiz",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"check\",\n  \"answers\": [\n    {\n      \"questionId\": \"pay-yourself-first\",\n      \"optionId\": \"0\"\n    },\n    {\n      \"questionId\": \"saving-streak\",\n      \"optionId\": \"0\"\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Read savings lesson",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lessons/bank-accounts-upi"
      }
    },
    {
      "name": "4. Record savings lesson",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/bank-accounts-upi/progress",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"read\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Grade savings quiz",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{savingsQuizKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/bank-accounts-upi/quiz",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"check\",\n  \"answers\": [\n    {\n      \"questionId\": \"virtual-money\",\n      \"optionId\": \"0\"\n    },\n    {\n      \"questionId\": \"saving-purpose\",\n      \"optionId\": \"0\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Read FD lesson",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/lessons/fixed-deposit"
      }
    },
    {
      "name": "7. Record FD lesson",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/fixed-deposit/progress",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"read\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Grade FD quiz",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{fdQuizKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/lessons/fixed-deposit/quiz",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"check\",\n  \"answers\": [\n    {\n      \"questionId\": \"fd-rate\",\n      \"optionId\": \"0\"\n    },\n    {\n      \"questionId\": \"fd-assumptions\",\n      \"optionId\": \"0\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. Check unlocks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/progress"
      }
    },
    {
      "name": "10. Open virtual FD (repeat unchanged to test idempotency)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{investmentKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/portfolio/fd",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"principalPaise\": 100000,\n  \"tenureMonths\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. Read persisted portfolio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/portfolio"
      }
    },
    {
      "name": "12. Goal assumptions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/goals/plan",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetPaise\": 9000000,\n  \"currentSavingsPaise\": 0,\n  \"months\": 24,\n  \"assumedAnnualRatePercent\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13. Dated FD snapshot",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/market/FD-1Y"
      }
    },
    {
      "name": "14. NAV quote with fallback",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/market/120716"
      }
    },
    {
      "name": "15. Real NAV history replay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/time-machine",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symbol\": \"120716\",\n  \"from\": \"2020-02-01T00:00:00+05:30\",\n  \"to\": \"2020-04-30T23:59:59+05:30\",\n  \"initialPaise\": 100000,\n  \"panicSellAt\": \"2020-03-23T00:00:00+05:30\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "16. Assigned facilitator aggregate (requires admin membership)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/facilitator/cohorts/{{cohortId}}/progress"
      }
    },
    {
      "name": "Learning runs (navigation only; required topic drafts may be unavailable)",
      "item": [
        {
          "name": "Start activity (requires needs-vs-wants completion)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{startRunKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/activities/needs-or-wants/runs",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"runId\", pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List current profile runs (switch A/B tokens to test isolation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/learning-runs"
          }
        },
        {
          "name": "Read owned run",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/learning-runs/{{runId}}"
          }
        },
        {
          "name": "Save bookmark; repeat same key/body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bookmarkKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/learning-runs/{{runId}}/bookmark",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedRevision\": 0,\n  \"bookmark\": {\n    \"kind\": \"item\",\n    \"itemId\": \"rice-and-dal\"\n  }\n}"
            }
          }
        },
        {
          "name": "Reject client-completed claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{startRunKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/activities/needs-or-wants/runs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            }
          }
        },
        {
          "name": "Start episode (requires its graph unlock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "55555555-5555-4555-8555-555555555555"
              }
            ],
            "url": "{{baseUrl}}/api/episodes/march-2020-hospital-bill/runs",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "Approved activity answers (requires legitimate run)",
      "item": [
        {
          "name": "Answer sort item; repeat unchanged to test idempotency",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{activityAnswerKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/learning-runs/{{runId}}/answers",
            "body": {
              "mode": "raw",
              "raw": "{\"expectedRevision\":0,\"itemId\":\"rice-and-dal\",\"categoryId\":\"need\"}"
            },
            "description": "Set expectedRevision to the run revision. Confirm one evidence row/revision; same key/body returns original. A new key for this item at current revision gives 409 already_answered. Changed source hash gives 409 content_changed."
          }
        },
        {
          "name": "Answer story current node",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{activityAnswerKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/learning-runs/{{runId}}/answers",
            "body": {
              "mode": "raw",
              "raw": "{\"expectedRevision\":0,\"nodeId\":\"the-offer\",\"choiceId\":\"replace-with-authored-choice-id\"}"
            },
            "description": "Use a story run and actual authored choice; bad or non-current choices give 422. Preserve verdict and cashDeltaPaise; portfolio cash must not change. Reaching ending completes only this run."
          }
        },
        {
          "name": "Reject client activity correctness",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{activityAnswerKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/learning-runs/{{runId}}/answers",
            "body": {
              "mode": "raw",
              "raw": "{\"expectedRevision\":0,\"itemId\":\"rice-and-dal\",\"categoryId\":\"need\",\"correct\":true}"
            }
          }
        },
        {
          "name": "Read own activity evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{publishableKey}}"
              }
            ],
            "url": "{{supabaseUrl}}/rest/v1/activity_answers?select=*&run_id=eq.{{runId}}",
            "description": "A reads own rows. With B token and A runId expect empty array. Never include server credentials."
          }
        }
      ]
    }
  ]
}
